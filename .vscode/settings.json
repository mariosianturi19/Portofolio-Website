{
  // Memberitahu VS Code CSS language server bahwa @tailwind dan @apply
  // adalah valid PostCSS/Tailwind directives, bukan unknown at-rules.
  "css.customData": [".vscode/tailwind.css-data.json"],
  "css.validate": false,
  "scss.validate": false,

  // Agar Tailwind IntelliSense (jika sudah diinstall) bekerja optimal
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },

  // Exclude noise dari file watcher
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/out/**": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/out": true
  }
}
